      },
      {
        "post": { "text": "A delayed update.", "labels": { "rid": "note-2", "by": "agent", "kind": "note" } },
        "rootLabels": { "rid": "work-1", "by": "agent", "repo": "example/project", "status": "open", "pr.1": "https://example.com/pull/1", "ask": "answered", "turn": "answer-1" }
      },
      {
        "post": { "text": "Resolved.", "labels": { "rid": "done-1", "by": "agent", "kind": "done", "re": "answer-1" } },
        "rootLabels": { "rid": "work-1", "by": "agent", "repo": "example/project", "status": "done", "pr.1": "https://example.com/pull/1" }
      },
      {
        "post": { "text": "Please revisit the draft.", "labels": { "rid": "answer-2", "by": "user", "kind": "answer" } },
        "rootLabels": { "rid": "work-1", "by": "agent", "repo": "example/project", "status": "open", "pr.1": "https://example.com/pull/1", "ask": "answered", "turn": "answer-2" }
