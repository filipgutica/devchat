{
  "name": "@filipgutica/devchat",
  "version": "0.0.0-development",
  "description": "Shared contracts and server tooling for the devchat board",
  "type": "module",
  "bin": {
    "devchat-host": "./dist/host/cli.js"
  },
  "files": ["dist", "fixtures", "docs/layout.md", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/shared/layout.d.ts",
      "import": "./dist/shared/layout.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config ui/vite.config.ts",
    "dev": "node scripts/dev.ts",
    "release": "semantic-release",
    "test": "node --test test/*.test.ts",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui && tsc --noEmit -p test/ui",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm pack --dry-run"
  },
  "engines": {
    "node": ">=22.20"
  },
  "packageManager": "pnpm@11.6.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipgutica/devchat.git"
  },
  "dependencies": {
    "@vercel/board": "0.56.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@filipgutica/design-system": "1.0.46",
    "@playwright/test": "1.65.1",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@ui-sdk/core": "0.1.0-beta.5",
    "@ui-sdk/react": "0.1.0-beta.5",
    "@vitejs/plugin-react": "6.2.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "semantic-release": "25.0.9",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
